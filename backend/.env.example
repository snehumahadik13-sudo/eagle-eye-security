# Server
PORT=4000
# Comma-separated list of origins allowed to call this API
FRONTEND_ORIGINS=https://eagleeyesecurity.in,https://www.eagleeyesecurity.in,https://admin.eagleeyesecurity.in

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key — SERVER ONLY. Never send this to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (any SMTP provider: Gmail app password, SendGrid SMTP,
# Zoho, Brevo, etc. all work the same way here)
ADMIN_NOTIFY_EMAIL=admin@eagleeyesecurity.in
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Eagle Eye Security Website <no-reply@eagleeyesecurity.in>"
